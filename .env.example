# Copia este archivo a .env y ajusta los valores. .env nunca se commitea.
# Usuario, contraseña, BD y puerto deben coincidir con la cadena de conexión del MCP de PostgreSQL.
# Back-End y Base de Datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=aventura_criaturas
POSTGRES_PUERTO=5432
DATABASE_URL="postgresql://postgres:cambiar_esta_contrasena@localhost:5432/aventura_criaturas?schema=public"

# API y Seguridad
PUERTO_API=3000
CORS_ORIGEN=http://localhost:5173
JWT_SECRETO=clave_secreta_jwt_para_desarrollo_cambiar_en_produccion_2026
