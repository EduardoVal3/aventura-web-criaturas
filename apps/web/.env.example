VITE_MODO_API=http
# En local directo usar http://localhost:3000; detrás de Kong Gateway usar http://localhost:8000
# En producción (Cloudflare Pages) usar la URL HTTPS pública del Back-End sin barra final ni /api
VITE_URL_API=http://localhost:3000
# Opcional (solo al usar Kong Gateway con key-auth): debe coincidir con KONG_CLAVE_API de la raíz .env
# VITE_CLAVE_GATEWAY=cambiar_esta_clave_gateway_local
