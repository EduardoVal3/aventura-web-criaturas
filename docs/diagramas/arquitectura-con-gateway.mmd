flowchart TD
    subgraph Cliente["1. Capa de Cliente"]
        Navegador["Navegador Web (apps/web Vite :5173)<br/>VITE_URL_API + apikey opcional (VITE_CLAVE_GATEWAY)<br/>+ Authorization: Bearer JWT"]
        Verificador["Script de Verificación / Cliente HTTP<br/>(scripts/verificar-gateway.mjs)"]
    end

    subgraph Gateway["2. API Gateway — Kong 3.9.5 DB-less (Docker: aventura-kong)"]
        Proxy["Proxy HTTP (:8000) · Admin solo lectura (127.0.0.1:8001)<br/>Plantilla declarativa kong/kong.yml.plantilla → /tmp/kong.yml"]
        PluginCors["Plugin cors<br/>Origen exacto CORS_ORIGEN · credentials: true<br/>Responde preflight OPTIONS sin consumir cuota"]
        PluginKeyAuth["Plugin key-auth<br/>Cabecera apikey · run_on_preflight: false<br/>hide_credentials: true · Consumidor cliente-web-aethelgard"]
        Rechazo401["HTTP 401 Unauthorized<br/>(Sin apikey o credencial inválida)"]
        RutaExploracion["Ruta ruta-exploracion<br/>/api/exploracion* (strip_path: false)"]
        RutaGeneral["Ruta ruta-api-general<br/>/api* (strip_path: false)"]
        PluginRateLimit["Plugin rate-limiting<br/>5 req/min · policy: local · limit_by: consumer<br/>Cabeceras X-RateLimit-* y RateLimit-*"]
        Rechazo429["HTTP 429 Too Many Requests<br/>+ X-RateLimit-Remaining-Minute: 0 + Retry-After"]
        LogsKong["Observabilidad<br/>Logs en /dev/stdout y /dev/stderr<br/>(docker compose logs kong)"]
    end

    subgraph Backend["3. Back-End NestJS 10 (apps/api en host.docker.internal:3000 · 44 rutas / 46 ops)"]
        PipelineNest["Prefijo /api · CORS (S-7)<br/>AutenticacionGuard (JWT) · ValidationPipe (S-6) · ExcepcionesFilter"]
        CtrlExploracion["ExploracionController<br/>(POST /api/exploracion y /explorar)"]
        CtrlDominio["14 Controladores y 15 Módulos de Dominio<br/>(salud, autenticación, usuarios, personajes, mundo, criaturas,<br/>encuentros, combate, equipo, inventario, tienda, curación, progreso, historial, externo)"]
    end

    subgraph Persistencia["4. Persistencia Relacional"]
        Prisma["PrismaService (ORM 6.3.1 · FOR UPDATE)"]
        Postgres["PostgreSQL 17 (15 tablas)<br/>(Docker aventura-postgres :5432, local o Neon en nube)"]
    end

    Navegador -->|"Modo con Gateway (:8000)"| Proxy
    Verificador --> Proxy
    Navegador -.->|"Modo directo local (:3000) o nube (Render Free)<br/>sin VITE_CLAVE_GATEWAY"| PipelineNest

    Proxy --> PluginCors
    PluginCors --> PluginKeyAuth
    PluginKeyAuth -->|"Credencial ausente/inválida"| Rechazo401
    PluginKeyAuth -->|"apikey válida"| RutaExploracion
    PluginKeyAuth -->|"apikey válida"| RutaGeneral

    RutaExploracion --> PluginRateLimit
    PluginRateLimit -->|"Cuota excedida"| Rechazo429
    PluginRateLimit -->|"Dentro del límite"| PipelineNest
    RutaGeneral --> PipelineNest

    Proxy -.-> LogsKong

    PipelineNest --> CtrlExploracion
    PipelineNest --> CtrlDominio
    CtrlExploracion --> Prisma
    CtrlDominio --> Prisma
    Prisma --> Postgres
