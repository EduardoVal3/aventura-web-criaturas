  "info": {
    "title": "Aethelgard API REST",
    "description": "Documentación interactiva de la API REST del juego Aethelgard",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegistroDto": {
        "type": "object",
        "properties": {
          "nombreUsuario": {
            "type": "string",
            "example": "arturo_sendas",
            "description": "Nombre de usuario único"
          },
          "correo": {
            "type": "string",
            "example": "arturo@ejemplo.com",
            "description": "Correo electrónico único"
          },
          "clave": {
            "type": "string",
            "example": "SecretoSeguro2026!",
            "description": "Contraseña de acceso"
          }
        },
        "required": [
          "nombreUsuario",
          "correo",
          "clave"
        ]
      },
      "IngresoDto": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "example": "arturo@ejemplo.com",
            "description": "Correo electrónico registrado"
          },
          "clave": {
            "type": "string",
            "example": "SecretoSeguro2026!",
            "description": "Contraseña de la cuenta"
          }
        },
        "required": [
          "correo",
          "clave"
        ]
      },
      "CrearPersonajeDto": {
        "type": "object",
        "properties": {}
      },
      "ActualizarOrdenEquipoDto": {
        "type": "object",
        "properties": {}
      },
      "MoverCriaturaEquipoDto": {
        "type": "object",
        "properties": {}
      },
      "ViajarDto": {
        "type": "object",
        "properties": {}
      },
      "VerificarZonaDto": {
        "type": "object",
        "properties": {
          "zonaId": {
            "type": "string",
            "description": "Identificador de la zona a verificar y desbloquear",
            "example": "ZON-05"
          }
        },
        "required": [
          "zonaId"
        ]
      },
      "CapturarDto": {
        "type": "object",
        "properties": {
          "encuentroId": {
            "type": "string",
            "description": "Identificador del encuentro (requerido para endpoint /api/combate/capturar)",
            "example": "enc-401"
          },
          "itemCodigo": {
            "type": "string",
            "description": "Código del talismán a emplear en el intento de captura",
            "example": "talisman-basico"
          },
          "turnoEsperado": {
            "type": "number",
            "description": "Turno esperado por el cliente para prevenir desincronizaciones",
            "example": 1
          }
        },
        "required": [
          "itemCodigo"
        ]
      },
      "AtacarDto": {
        "type": "object",
        "properties": {
          "encuentroId": {
            "type": "string",
            "description": "Identificador único del encuentro en curso",
            "example": "enc-401"
          },
          "movimientoIndice": {
            "type": "number",
            "description": "Índice del movimiento a utilizar por la criatura activa (0 a 3)",
            "example": 0,
            "default": 0
          },
          "turnoEsperado": {
            "type": "number",
            "description": "Turno esperado por el cliente para prevenir desincronizaciones concurrentes",
            "example": 1
          }
        },
        "required": [
          "encuentroId"
        ]
      },
      "HuirDto": {
        "type": "object",
        "properties": {
          "encuentroId": {
            "type": "string",
            "description": "Identificador único del encuentro en curso",
            "example": "enc-401"
          },
          "turnoEsperado": {
            "type": "number",
            "description": "Turno esperado por el cliente para prevenir desincronizaciones concurrentes",
            "example": 1
          }
        },
        "required": [
          "encuentroId"
        ]
      },
      "AccionCombateDto": {
        "type": "object",
        "properties": {
          "tipoAccion": {
            "type": "string",
            "description": "Tipo de acción a ejecutar en el turno de combate",
            "enum": [
              "ATACAR",
              "RESONANCIA",
              "USAR_OBJETO",
              "CAMBIAR_CRIATURA",
              "CAPTURAR",
              "HUIR"
            ],
            "example": "ATACAR"
          },
          "movimientoIndice": {
            "type": "number",
            "description": "Índice del movimiento a ejecutar (si tipoAccion es ATACAR, 0 a 3)",
            "example": 0,
            "default": 0
          },
          "itemCodigo": {
            "type": "string",
            "description": "Código del objeto a utilizar (si tipoAccion es USAR_OBJETO o CAPTURAR)",
            "example": "talisman-basico"
          },
          "turnoEsperado": {
            "type": "number",
            "description": "Turno esperado por el cliente para prevenir desincronizaciones concurrentes",
            "example": 1
          }
        },
        "required": [
          "tipoAccion"
        ]
      },
      "UsarObjetoDto": {
        "type": "object",
        "properties": {
          "itemCodigo": {
            "type": "string",
            "description": "Código único del objeto consumible a utilizar",
            "example": "pocion-menor"
          },
          "criaturaId": {
            "type": "string",
            "description": "Identificador único de la criatura aliada destinataria",
            "example": "cri-301"
          }
        },
        "required": [
          "itemCodigo",
          "criaturaId"
        ]
      },
      "ComprarDto": {
        "type": "object",
        "properties": {
          "itemCodigo": {
            "type": "string",
            "description": "Código del objeto que se desea adquirir en la tienda",
            "example": "talisman-basico"
          },
          "cantidad": {
            "type": "number",
            "description": "Cantidad de unidades a comprar",
            "example": 1,
            "default": 1
          }
        },
        "required": [
          "itemCodigo"
        ]
      }
    }
  }
}
