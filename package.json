{
  "name": "aventura-web-criaturas",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "docker compose up -d postgres && pnpm -r --parallel run dev",
    "test": "pnpm --filter api test",
    "graphify": "py -m graphify extract . --code-only && py -m graphify export html && py -m graphify tree",
    "graphify:update": "py -m graphify update .",
    "graphify:mcp": "py -m graphify.serve graphify-out/graph.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  }
}
